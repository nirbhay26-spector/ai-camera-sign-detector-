# ==============================================================================
# SMART AI SAFETY CAMERA - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and fill in your actual settings:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. CAMERA CONFIGURATION
# ------------------------------------------------------------------------------
# CAMERA_SOURCE:
#   - 0 for primary built-in webcam
#   - 1 or 2 for external USB camera
#   - "rtsp://username:password@192.168.1.100:554/stream1" for CCTV/IP camera
#   - "samples/test_gesture.mp4" for testing with a recorded video file
CAMERA_SOURCE=0
FRAME_WIDTH=1280
FRAME_HEIGHT=720
TARGET_FPS=15

# ------------------------------------------------------------------------------
# 2. FALSE ALARM REDUCTION & DECISION TIMING
# ------------------------------------------------------------------------------
# CONFIRMATION_SECONDS: Number of seconds the distress signal must be held
# continuously before triggering an alert (default: 2.5s).
CONFIRMATION_SECONDS=2.5

# COOLDOWN_SECONDS: Quiet period in seconds after an alert. Prevents sending
# dozens of duplicate SMS messages for a single incident (default: 60s).
COOLDOWN_SECONDS=60.0

# STATE_EXPIRY_SECONDS: Maximum time allowed between step 1 (open palm),
# step 2 (thumb tucked), and step 3 (fist closed) before the state resets.
STATE_EXPIRY_SECONDS=3.0

# ------------------------------------------------------------------------------
# 3. SAFETY AND TEST MODES
# ------------------------------------------------------------------------------
# DRY_RUN:
#   - Set to 'true' to test the full system without sending real Twilio SMS.
#     The alert text and coordinates will be printed cleanly to your terminal.
#   - Set to 'false' when you want live SMS sent to your phone.
DRY_RUN=true

# TEST_MODE:
#   - Keep 'true' so alerts are restricted ONLY to ALERT_RECIPIENT_PHONE.
#   - Automated alerts to emergency numbers (112 / 911) are strictly prohibited.
TEST_MODE=true

# ------------------------------------------------------------------------------
# 4. TWILIO SMS CREDENTIALS
# ------------------------------------------------------------------------------
# Sign up at https://www.twilio.com (free trial available)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ALERT_RECIPIENT_PHONE: The phone number of the camera owner / designated contact
# Must include country code (e.g. +91 for India, +1 for USA)
ALERT_RECIPIENT_PHONE=+919876543210

# ------------------------------------------------------------------------------
# 5. CAMERA LOCATION & GOOGLE MAPS LINK
# ------------------------------------------------------------------------------
CAMERA_LOCATION_NAME=Main Gate / Front Porch
CAMERA_LOCATION_ADDRESS=Block 4, University Campus, Sector 62, Noida, Uttar Pradesh, India
CAMERA_LATITUDE=28.6280
CAMERA_LONGITUDE=77.3649

# ------------------------------------------------------------------------------
# 6. EVIDENCE RECORDING
# ------------------------------------------------------------------------------
EVIDENCE_DIR=evidence
PRE_EVENT_BUFFER_SECONDS=4.0
POST_EVENT_RECORD_SECONDS=4.0
